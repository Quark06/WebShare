# Copy to .env. Uncomment and fill only the settings you need.
# Configuration: docs/CONFIGURATION.md

# Login is disabled by default; set your own Firebase project to enable it
VITE_FIREBASE_CONFIG=
# VITE_FIREBASE_CONFIG={"apiKey":"YOUR_PUBLIC_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT"}

# Optional integrations use your own accounts and services.
# Production behind Nginx: NODE_ENV=production, HOST=127.0.0.1, PORT=8080
# In Docker, use HOST=0.0.0.0 and publish the port on the host as needed.
# VITE_* settings are public build-time settings; rebuild after changing them.
# Optional: direct YouTube link metadata and playlist imports (not required for search)
# YOUTUBE_API_KEY=REPLACE_ME
# Optional: YouTube search proxy; otherwise use HTTPS_PROXY/HTTP_PROXY or Windows system proxy
# YOUTUBE_PROXY_URL=http://127.0.0.1:10808
# Optional: Bilibili search / live high-quality Cookie (server only)
# BILIBILI_COOKIE=
# Optional third-party resolvers. Defaults preserve the local pipeline.
# BILIBILI_RESOLVER=bilibilix
# BILIBILI_LIVE_RESOLVER=bilibilix
# BILIBILIX_URL=https://www.bilibilix.com
# BILIBILIX_LIVE_URL=https://live.bilibilix.com
# MUSIC_RESOLVER=meting-api
# METING_API_URL=https://api.qijieya.cn/meting/
# METING_API_PLATFORMS=netease,tencent
# Optional: your own platform login cookies for Meting (server only)
# METING_NETEASE_COOKIE=
# METING_TENCENT_COOKIE=
# METING_KUGOU_COOKIE=
# METING_KUWO_COOKIE=
# FIREBASE_ADMIN_SDK_CONFIG=REPLACE_ME
# DATABASE_URL=postgresql://postgres@localhost:5432/postgres?sslmode=disable
# Optional: hours without visitors before a room is archived and leaves the room list (default 72)
# ROOM_ARCHIVE_HOURS=72
# Optional: permanent rooms each signed-in user can own (default 20, 0 for unlimited)
# PERMANENT_ROOM_LIMIT=20
# REDIS_URL=localhost:6379

# Optional: your own room-creation bot
# DISCORD_BOT_TOKEN=
# DISCORD_SITE_URL=https://watch.example.com
# DISCORD_API_URL=https://watch.example.com
# Optional: site-wide Discord login gate (server only); on when client ID, secret and server ID are set
# DISCORD_AUTH_CLIENT_ID=
# DISCORD_AUTH_CLIENT_SECRET=
# DISCORD_AUTH_GUILD_ID=123456789012345678
# DISCORD_AUTH_REDIRECT_URI=https://watch.example.com/auth/discord/callback
# DISCORD_AUTH_SESSION_DAYS=30
# Optional: WebRTC ICE servers (public build-time settings); STUN only by default
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"YOUR_USER","credential":"YOUR_TURN_CREDENTIAL"}]
